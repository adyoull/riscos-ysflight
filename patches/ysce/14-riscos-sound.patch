+const int RATE=22050;              // every WAV is converted to this, 16-bit mono
+const int TARGET_MS=160;           // sound kept queued: a slow frame is ~100 ms
+const int TARGET_BYTES=RATE*2*TARGET_MS/1000;
+const int MIN_WRITE_BYTES=512;     // don't bother with less
+const int FRAGMENT=(16<<16)|11;    // 16 fragments of 2048 bytes (46 ms each)
+const int MAX_ONESHOT=4;           // one-shots playing at once
+const int REOPEN_DELAY=200;        // KeepPlaying calls before trying a failed open again
+
+struct Voice
+{
+	const YsWavFile *wav;
+	unsigned int pos;              // in samples
+};
+
+YSBOOL masterSwitch=YSTRUE,environSwitch=YSTRUE,oneTimeSwitch=YSTRUE;
+
+YsWavFile jetWav[10],afterBurnerWav,propWav[10];
+YsWavFile machineGunWav[FSSND_NUM_MACHINEGUNTYPE];
+YsWavFile alarmWav[FSSND_NUM_ALARMTYPE];
+YsWavFile oneTimeWav[FSSND_NUM_ONETIMETYPE];
+
+FSSND_ENGINETYPE engineType=FSSND_ENGINE_SILENT;
+double enginePower=0.0;
+FSSND_MACHINEGUNTYPE machineGunType=FSSND_MACHINEGUN_SILENT;
+FSSND_ALARMTYPE alarmType=FSSND_ALARM_SILENT;
+
+Voice envVoice={NULL,0};
+Voice oneShot[MAX_ONESHOT];
+
+int dsp=-1;
+int openWait=0;                    // calls to wait before opening again
+YSBOOL loaded=YSFALSE;
+short mixBuf[TARGET_BYTES/2];
+int mixAcc[TARGET_BYTES/2];
+
+void Load(YsWavFile &wav,const char fn[])
+{
+	if(YSOK==wav.LoadWav(fn))
+	{
+		wav.ConvertToMono();
+		wav.ConvertTo16Bit();
+		wav.ConvertToSigned();
+		wav.Resample(RATE);
+	}
+}
+
+void LoadAll(void)
+{
+	char fn[64];
+	for(int i=0; i<10; ++i)
+	{
+		sprintf(fn,"sound/engine%d.wav",i);
+		Load(jetWav[i],fn);
+		sprintf(fn,"sound/prop%d.wav",i);
+		Load(propWav[i],fn);
+	}
+	Load(afterBurnerWav,"sound/burner.wav");
+
+	Load(machineGunWav[(int)FSSND_MACHINEGUN_MACHINEGUN],"sound/gun.wav");
+
+	Load(alarmWav[(int)FSSND_ALARM_STALL],"sound/stallhorn.wav");
+	Load(alarmWav[(int)FSSND_ALARM_MISSILE],"sound/warning.wav");
+	Load(alarmWav[(int)FSSND_ALARM_TERRAIN],"sound/gearhorn.wav");
+
+	Load(oneTimeWav[(int)FSSND_ONETIME_DAMAGE],"sound/damage.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_MISSILE],"sound/missile.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_BANG],"sound/bang.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_BLAST],"sound/blast.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_TOUCHDWN],"sound/touchdwn.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_HIT],"sound/hit.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_BLAST2],"sound/blast2.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_GEARUP],"sound/retractldg.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_GEARDOWN],"sound/extendldg.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_BOMBSAWAY],"sound/bombsaway.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_ROCKET],"sound/rocket.wav");
+	Load(oneTimeWav[(int)FSSND_ONETIME_NOTICE],"sound/notice.wav");
+}
+
+YSBOOL Playable(const YsWavFile *wav)
+{
+	return (NULL!=wav && 0<wav->NTimeStep() && 16==wav->BitPerSample() &&
+	        YSTRUE!=wav->Stereo()) ? YSTRUE : YSFALSE;
+}
+
+void ClearVoices(void)
+{
+	envVoice.wav=NULL;
+	envVoice.pos=0;
+	for(int i=0; i<MAX_ONESHOT; ++i)
+	{
+		oneShot[i].wav=NULL;
+		oneShot[i].pos=0;
+	}
+}
+
+void CloseDsp(void)
+{
+	if(0<=dsp)
+	{
+		DSP_IOCTL(dsp,SNDCTL_DSP_RESET,NULL);   // drop what's queued: close doesn't wait
+		DSP_CLOSE(dsp);
+		dsp=-1;
+	}
+}
+
+YSBOOL OpenDsp(void)
+{
+	if(0<=dsp)
+	{
+		return YSTRUE;
+	}
+	if(0<openWait)
+	{
+		--openWait;
+		return YSFALSE;
+	}
+	dsp=DSP_OPEN("/dev/dsp",O_WRONLY|O_NONBLOCK);
+	if(0>dsp)
+	{
+		printf("Sound: can't open /dev/dsp (%s); no sound.\n",strerror(errno));
+		openWait=REOPEN_DELAY;
+		return YSFALSE;
+	}
+	int fmt=AFMT_S16_LE,ch=1,rate=RATE,frag=FRAGMENT;
+	DSP_IOCTL(dsp,SNDCTL_DSP_SETFRAGMENT,&frag);
+	if(0!=DSP_IOCTL(dsp,SNDCTL_DSP_SETFMT,&fmt) || AFMT_S16_LE!=fmt ||
+	   0!=DSP_IOCTL(dsp,SNDCTL_DSP_CHANNELS,&ch) || 1!=ch ||
+	   0!=DSP_IOCTL(dsp,SNDCTL_DSP_SPEED,&rate))
+	{
+		printf("Sound: /dev/dsp doesn't take 16-bit mono; no sound.\n");
+		DSP_CLOSE(dsp);
+		dsp=-1;
+		openWait=REOPEN_DELAY;
+		return YSFALSE;
+	}
+	if(rate!=RATE)
+	{
+		printf("Sound: /dev/dsp plays at %d Hz, not %d.\n",rate,RATE);
+	}
+	printf("Sound: /dev/dsp open, %d Hz 16-bit mono.\n",RATE);
+	return YSTRUE;
+}
+
+// The looping sound for this frame, as upstream's ALSA plug-in picks it.
+const YsWavFile *EnvironWav(void)
+{
+	if(YSTRUE!=environSwitch)
+	{
+		return NULL;
+	}
+	if(FSSND_MACHINEGUN_SILENT!=machineGunType)
+	{
+		return &machineGunWav[(int)machineGunType];
+	}
+	if(FSSND_ALARM_SILENT!=alarmType)
+	{
+		return &alarmWav[(int)alarmType];
+	}
+	int level=(int)(enginePower*10.0);
+	if(level<0)
+	{
+		level=0;
+	}
+	else if(9<level)
+	{
+		level=9;
+	}
+	switch(engineType)
+	{
+	case FSSND_ENGINE_JETNORMAL:
+		return &jetWav[level];
+	case FSSND_ENGINE_JETAFTERBURNER:
+		return &afterBurnerWav;
+	case FSSND_ENGINE_PROPELLER:
+	case FSSND_ENGINE_TURBOPROP:
+	case FSSND_ENGINE_HELICOPTER:
+		return &propWav[level];
+	default:
+		return NULL;
+	}
+}
+
+// Add n samples of a voice into acc. A looping voice wraps; a one-shot
+// ends (its wav set to NULL).
+void MixVoice(Voice &v,int acc[],int n,YSBOOL loop)
+{
+	const unsigned int len=v.wav->NTimeStep();
+	const short *src=(const short *)v.wav->DataPointer();
+	int i=0;
+	while(i<n)
+	{
+		if(len<=v.pos)
+		{
+			if(YSTRUE!=loop)
+			{
+				v.wav=NULL;
+				v.pos=0;
+				return;
+			}
+			v.pos=0;
+		}
+		int run=(int)(len-v.pos);
+		if(n-i<run)
+		{
+			run=n-i;
+		}
+		for(int k=0; k<run; ++k)
+		{
+			acc[i+k]+=src[v.pos+k];
+		}
+		i+=run;
+		v.pos+=run;
+	}
+	if(YSTRUE!=loop && len<=v.pos)
+	{
+		v.wav=NULL;
+		v.pos=0;
+	}
+}
 
