+++ b/src/gui/CMakeLists.txt
@@ -25,11 +25,19 @@ fsguimaincanvas.h
 fsguisiminfodialog.h
 )
 
-find_package(CURL CONFIG REQUIRED)
-find_package(nlohmann_json CONFIG REQUIRED)
-
 add_library(${TARGET_NAME} ${SRCS} ${HEADERS})
 target_link_libraries(${TARGET_NAME} ${LIB_DEPENDENCY})
-target_link_libraries(${TARGET_NAME} ${LIB_DEPENDENCY} CURL::libcurl)
-target_link_libraries(${TARGET_NAME} ${LIB_DEPENDENCY} nlohmann_json::nlohmann_json)
+if(RISCOS)
+	set(YS_NO_SERVER_LIST ON)
+endif()
+if(YS_NO_SERVER_LIST)
+	# Without curl and nlohmann-json (RISC OS for now, or -DYS_NO_SERVER_LIST=ON)
+	# the server list download is compiled out and the host is typed in by hand.
+	target_compile_definitions(${TARGET_NAME} PRIVATE YS_NO_SERVER_LIST)
+else()
+	find_package(CURL REQUIRED)
+	find_package(nlohmann_json CONFIG REQUIRED)
+	target_link_libraries(${TARGET_NAME} ${LIB_DEPENDENCY} CURL::libcurl)
+	target_link_libraries(${TARGET_NAME} ${LIB_DEPENDENCY} nlohmann_json::nlohmann_json)
+endif()
 target_include_directories(${TARGET_NAME} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
