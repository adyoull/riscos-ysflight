+/* The screen in the program's pixels */
+static int LogicalW(void)
+{
+	return screenW/winScale;
+}
+
+static int LogicalH(void)
+{
+	return screenH/winScale;
+}
+
+/* Screen pixels (e.g. the title bar's height) in the program's pixels, rounded up */
+static int ToLogical(int screenPixels)
+{
+	return (screenPixels+winScale-1)/winScale;
+}
+
+/* The window scale EGL suggests for a window of w x h program pixels */
+static int ChooseScale(int w,int h)
+{
+	int s=(int)eglWindowScaleRISCOS(eglDpy,w,h);
+	if(s<1) s=1;
+	if(s>4) s=4;
+	return s;
+}
