diff --git a/src/fssimplewindow/src/riscos/fsriscoskeymap.cpp b/src/fssimplewindow/src/riscos/fsriscoskeymap.cpp
new file mode 100644
index 0000000..0cc5db6
--- /dev/null
+++ b/src/fssimplewindow/src/riscos/fsriscoskeymap.cpp
@@ -0,0 +1,138 @@
+/* fssimplewindow for RISC OS: key tables.
+
+   - Internal key numbers (OS_Byte 121, INKEY -n-1) to FSKEY_* codes, for
+     FsGetKeyState (keys held down) and for telling which physical key
+     produced a Key_Pressed event. The numbers are those in SDL 2.26's
+     src/video/riscos/scancodes_riscos.h (zlib licence), which follows the
+     RISC OS "Keyboard Scan Codes" documentation.
+   - Wimp Key_Pressed codes to FSKEY_* codes and characters, for keys that
+     can't be matched to a physical key (typed by software, or auto-repeat).
+
+   Part of the RISC OS port of YSFlight; same BSD-3 licence as the rest of
+   fssimplewindow. */
+
+#include "../fssimplewindow.h"
+#include "fsriscoskeymap.h"
+
+static const unsigned char internalToFskey[128]=
+{
+	/*   0 Shift  */ FSKEY_SHIFT,      /*   1 Ctrl   */ FSKEY_CTRL,
+	/*   2 Alt    */ FSKEY_ALT,        /*   3 LShift */ FSKEY_LEFT_SHIFT,
+	/*   4 LCtrl  */ FSKEY_LEFT_CTRL,  /*   5 LAlt   */ FSKEY_LEFT_ALT,
+	/*   6 RShift */ FSKEY_RIGHT_SHIFT,/*   7 RCtrl  */ FSKEY_RIGHT_CTRL,
+	/*   8 RAlt   */ FSKEY_RIGHT_ALT,  /*   9 Select */ FSKEY_NULL,
+	/*  10 Menu   */ FSKEY_NULL,       /*  11 Adjust */ FSKEY_NULL,
+	/*  12 */ FSKEY_NULL, /*  13 */ FSKEY_NULL, /*  14 */ FSKEY_NULL, /*  15 */ FSKEY_NULL,
+	/*  16 */ FSKEY_Q,      /*  17 */ FSKEY_3,      /*  18 */ FSKEY_4,      /*  19 */ FSKEY_5,
+	/*  20 */ FSKEY_F4,     /*  21 */ FSKEY_8,      /*  22 */ FSKEY_F7,     /*  23 */ FSKEY_MINUS,
+	/*  24 */ FSKEY_6,      /*  25 */ FSKEY_LEFT,   /*  26 */ FSKEY_TEN6,   /*  27 */ FSKEY_TEN7,
+	/*  28 */ FSKEY_F11,    /*  29 */ FSKEY_F12,    /*  30 */ FSKEY_F10,    /*  31 */ FSKEY_SCROLLLOCK,
+	/*  32 */ FSKEY_PRINTSCRN,/*33 */ FSKEY_W,      /*  34 */ FSKEY_E,      /*  35 */ FSKEY_T,
+	/*  36 */ FSKEY_7,      /*  37 */ FSKEY_I,      /*  38 */ FSKEY_9,      /*  39 */ FSKEY_0,
+	/*  40 */ FSKEY_MINUS,  /*  41 */ FSKEY_DOWN,   /*  42 */ FSKEY_TEN8,   /*  43 */ FSKEY_TEN9,
+	/*  44 */ FSKEY_PAUSEBREAK,/*45 */ FSKEY_TILDA, /*  46 */ FSKEY_NULL,   /*  47 */ FSKEY_BS,
+	/*  48 */ FSKEY_1,      /*  49 */ FSKEY_2,      /*  50 */ FSKEY_D,      /*  51 */ FSKEY_R,
+	/*  52 */ FSKEY_6,      /*  53 */ FSKEY_U,      /*  54 */ FSKEY_O,      /*  55 */ FSKEY_P,
+	/*  56 */ FSKEY_LBRACKET,/*57 */ FSKEY_UP,      /*  58 */ FSKEY_TENPLUS,/*  59 */ FSKEY_TENMINUS,
+	/*  60 */ FSKEY_TENENTER,/*61 */ FSKEY_INS,     /*  62 */ FSKEY_HOME,   /*  63 */ FSKEY_PAGEUP,
+	/*  64 */ FSKEY_CAPSLOCK,/*65 */ FSKEY_A,       /*  66 */ FSKEY_X,      /*  67 */ FSKEY_F,
+	/*  68 */ FSKEY_Y,      /*  69 */ FSKEY_J,      /*  70 */ FSKEY_K,      /*  71 */ FSKEY_2,
+	/*  72 */ FSKEY_SEMICOLON,/*73 */ FSKEY_ENTER,  /*  74 */ FSKEY_TENSLASH,/* 75 */ FSKEY_NULL,
+	/*  76 */ FSKEY_TENDOT, /*  77 */ FSKEY_NUMLOCK,/*  78 */ FSKEY_PAGEDOWN,/* 79 */ FSKEY_SINGLEQUOTE,
+	/*  80 */ FSKEY_NULL,   /*  81 */ FSKEY_S,      /*  82 */ FSKEY_C,      /*  83 */ FSKEY_G,
+	/*  84 */ FSKEY_H,      /*  85 */ FSKEY_N,      /*  86 */ FSKEY_L,      /*  87 */ FSKEY_SEMICOLON,
+	/*  88 */ FSKEY_RBRACKET,/*89 */ FSKEY_DEL,     /*  90 */ FSKEY_NULL,   /*  91 */ FSKEY_TENSTAR,
+	/*  92 */ FSKEY_NULL,   /*  93 */ FSKEY_PLUS,   /*  94 */ FSKEY_BACKSLASH,/*95 */ FSKEY_NULL,
+	/*  96 */ FSKEY_TAB,    /*  97 */ FSKEY_Z,      /*  98 */ FSKEY_SPACE,  /*  99 */ FSKEY_V,
+	/* 100 */ FSKEY_B,      /* 101 */ FSKEY_M,      /* 102 */ FSKEY_COMMA,  /* 103 */ FSKEY_DOT,
+	/* 104 */ FSKEY_SLASH,  /* 105 */ FSKEY_END,    /* 106 */ FSKEY_TEN0,   /* 107 */ FSKEY_TEN1,
+	/* 108 */ FSKEY_TEN3,   /* 109 */ FSKEY_NULL,   /* 110 */ FSKEY_NULL,   /* 111 */ FSKEY_NULL,
+	/* 112 */ FSKEY_ESC,    /* 113 */ FSKEY_F1,     /* 114 */ FSKEY_F2,     /* 115 */ FSKEY_F3,
+	/* 116 */ FSKEY_F5,     /* 117 */ FSKEY_F6,     /* 118 */ FSKEY_F8,     /* 119 */ FSKEY_F9,
+	/* 120 */ FSKEY_BACKSLASH,/*121 */ FSKEY_RIGHT, /* 122 */ FSKEY_TEN4,   /* 123 */ FSKEY_TEN5,
+	/* 124 */ FSKEY_TEN2,   /* 125 */ FSKEY_NULL,   /* 126 */ FSKEY_NULL,   /* 127 */ FSKEY_CONTEXT,
+};
+
+int FsRiscOsInternalKeyToFskey(int internal)
+{
+	if(0<=internal && internal<128)
+	{
+		return internalToFskey[internal];
+	}
+	return FSKEY_NULL;
+}
+
+int FsRiscOsWimpKeyToFskey(int code)
+{
+	if('a'<=code && code<='z')
+	{
+		return FSKEY_A+(code-'a');
+	}
+	if('A'<=code && code<='Z')
+	{
+		return FSKEY_A+(code-'A');
+	}
+	if('0'<=code && code<='9')
+	{
+		return FSKEY_0+(code-'0');
+	}
+	switch(code)
+	{
+	case ' ':  return FSKEY_SPACE;
+	case 0x1B: return FSKEY_ESC;
+	case 0x0D: return FSKEY_ENTER;
+	case 0x08: return FSKEY_BS;
+	case 0x7F: return FSKEY_DEL;
+	case 0x1E: return FSKEY_HOME;
+	case '-': case '_':  return FSKEY_MINUS;
+	case '=': case '+':  return FSKEY_PLUS;
+	case '[': case '{':  return FSKEY_LBRACKET;
+	case ']': case '}':  return FSKEY_RBRACKET;
+	case '\\': case '|': return FSKEY_BACKSLASH;
+	case ';': case ':':  return FSKEY_SEMICOLON;
+	case '\'': case '"': return FSKEY_SINGLEQUOTE;
+	case ',': case '<':  return FSKEY_COMMA;
+	case '.': case '>':  return FSKEY_DOT;
+	case '/': case '?':  return FSKEY_SLASH;
+	case '`': case '~':  return FSKEY_TILDA;
+	}
+	if(0x100<=code)
+	{
+		/* Function and cursor keys: Shift adds 0x10, Ctrl 0x20. */
+		int base=code&~0x30;
+		switch(base)
+		{
+		case 0x180: return FSKEY_PRINTSCRN;
+		case 0x181: case 0x182: case 0x183: case 0x184: case 0x185:
+		case 0x186: case 0x187: case 0x188: case 0x189:
+			return FSKEY_F1+(base-0x181);
+		case 0x18A: return FSKEY_TAB;
+		case 0x18B: return FSKEY_END;          /* Copy / End */
+		case 0x18C: return FSKEY_LEFT;
+		case 0x18D: return FSKEY_RIGHT;
+		case 0x18E: return (code&0x10) ? FSKEY_PAGEDOWN : FSKEY_DOWN;
+		case 0x18F: return (code&0x10) ? FSKEY_PAGEUP : FSKEY_UP;
+		case 0x1CA: return FSKEY_F10;
+		case 0x1CB: return FSKEY_F11;
+		case 0x1CC: return FSKEY_F12;
+		case 0x1CD: return FSKEY_INS;
+		}
+	}
+	return FSKEY_NULL;
+}
+
+int FsRiscOsWimpKeyToChar(int code)
+{
+	switch(code)
+	{
+	case 0x1B: return 0x1B;
+	case 0x08: return 0x08;
+	case 0x0D: return '\n';
+	case 0x18A: return '\t';
+	}
+	if((0x20<=code && code<0x7F) || (0xA0<=code && code<0x100))
+	{
+		return code;
+	}
+	return 0;
+}
