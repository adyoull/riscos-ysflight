+/* Wait without stopping the desktop: Wimp_PollIdle until the time is up,
+   handling events meanwhile. Short waits (under 5 ms) poll once and then
+   wait against the clock. Main thread only (the Wimp); other threads, and
+   the program before its window is open, use usleep. */
+void FsSleep(int ms)
+{
+	if(ms<=0)
+	{
+		return;
+	}
+	if(0==task)
+	{
+		usleep(ms*1000);
+		return;
+	}
+	long long int until=FsSubSecondTimer()+ms;
+	int block[64];
+	_kernel_swi_regs r;
+	for(;;)
+	{
+		long long int left=until-FsSubSecondTimer();
+		if(left<=0)
+		{
+			break;
+		}
+		if(left<5)
+		{
+			r.r[0]=0;
+			r.r[1]=(int)block;
+			if(NULL==_kernel_swi(Wimp_Poll,&r,&r) && 0!=r.r[0])
+			{
+				HandleEvent(r.r[0],block);
+			}
+			while(FsSubSecondTimer()<until)
+			{
+			}
+			break;
+		}
+		r.r[0]=0;
+		r.r[1]=(int)block;
+		r.r[2]=MonotonicCs()+(int)(left/10);
+		if(NULL!=_kernel_swi(Wimp_PollIdle,&r,&r))
+		{
+			break;
+		}
+		if(0!=r.r[0])
+		{
+			HandleEvent(r.r[0],block);
+		}
+	}
+}
+
+long long int FsPassedTime(void)
+{
+	static long long int lastTick;
+	static int first=1;
+	long long int tick=FsSubSecondTimer();
+	if(0!=first)
+	{
+		lastTick=tick;
+		first=0;
+	}
+	long long int passed=tick-lastTick;
+	lastTick=tick;
+	return passed;
+}
+
+/* Milliseconds. UnixLib 5.0.3.1's CLOCK_MONOTONIC reads the HAL counter,
+   so it's finer than the centisecond OS_ReadMonotonicTime. */
+long long int FsSubSecondTimer(void)
+{
+	static long long int t0=-1;
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC,&ts);
+	long long int ms=(long long int)ts.tv_sec*1000+ts.tv_nsec/1000000;
+	if(t0<0)
+	{
+		t0=ms;
+	}
+	return ms-t0;
+}
