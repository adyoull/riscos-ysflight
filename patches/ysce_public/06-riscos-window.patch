+void FsX11GetClipBoardString(long long int &returnLength,char *&returnStr)
+{
+	returnLength=0;
+	returnStr=NULL;
+	if(NULL!=clipBoard)
+	{
+		returnStr=new char [clipBoardLength+1];
+		memcpy(returnStr,clipBoard,clipBoardLength);
+		returnStr[clipBoardLength]=0;
+		returnLength=clipBoardLength;
+	}
+}
