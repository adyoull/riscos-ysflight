+void FsSoundSetOneTime(FSSND_ONETIMETYPE type)
+{
+	if(YSTRUE!=masterSwitch || YSTRUE!=oneTimeSwitch ||
+	   0>(int)type || FSSND_NUM_ONETIMETYPE<=(int)type)
+	{
+		return;
+	}
+	const YsWavFile *wav=&oneTimeWav[(int)type];
+	if(YSTRUE!=Playable(wav))
+	{
+		return;
+	}
+	// A free slot; if none, the one nearest its end makes room.
+	int slot=-1;
+	unsigned int bestLeft=0xffffffffu;
+	for(int i=0; i<MAX_ONESHOT; ++i)
+	{
+		if(NULL==oneShot[i].wav)
+		{
+			slot=i;
+			break;
+		}
+		const unsigned int left=oneShot[i].wav->NTimeStep()-oneShot[i].pos;
+		if(left<bestLeft)
+		{
+			bestLeft=left;
+			slot=i;
+		}
+	}
+	oneShot[slot].wav=wav;
+	oneShot[slot].pos=0;
 }
 
 void FsSoundKeepPlaying(void)
 {
+	if(YSTRUE!=masterSwitch || YSTRUE!=loaded)
+	{
+		return;
+	}
+
+	const YsWavFile *env=EnvironWav();
+	if(YSTRUE!=Playable(env))
+	{
+		env=NULL;
+	}
+	if(env!=envVoice.wav)
+	{
+		// Another engine level: carry on at the same place in the loop, so
+		// the sound changes without a jump back to the start.
+		envVoice.pos=(NULL!=env ? envVoice.pos%env->NTimeStep() : 0);
+		envVoice.wav=env;
+	}
+
+	YSBOOL busy=(NULL!=envVoice.wav ? YSTRUE : YSFALSE);
+	for(int i=0; i<MAX_ONESHOT; ++i)
+	{
+		if(NULL!=oneShot[i].wav)
+		{
+			busy=YSTRUE;
+		}
+	}
+	if(YSTRUE!=busy && 0>dsp)
+	{
+		return;   // nothing to play: don't open the device for silence
+	}
+	if(YSTRUE!=OpenDsp())
+	{
+		return;
+	}
+
+	int queued=0;
+	audio_buf_info space;
+	if(0!=DSP_IOCTL(dsp,SNDCTL_DSP_GETODELAY,&queued) ||
+	   0!=DSP_IOCTL(dsp,SNDCTL_DSP_GETOSPACE,&space))
+	{
+		return;
+	}
+	int want=TARGET_BYTES-queued;
+	if(space.bytes<want)
+	{
+		want=space.bytes;
+	}
+	want&=~1;
+	if(want<MIN_WRITE_BYTES)
+	{
+		return;
+	}
+
+	const int n=want/2;
+	memset(mixAcc,0,sizeof(int)*n);
+	if(NULL!=envVoice.wav)
+	{
+		MixVoice(envVoice,mixAcc,n,YSTRUE);
+	}
+	for(int i=0; i<MAX_ONESHOT; ++i)
+	{
+		if(NULL!=oneShot[i].wav)
+		{
+			MixVoice(oneShot[i],mixAcc,n,YSFALSE);
+		}
+	}
+	for(int i=0; i<n; ++i)
+	{
+		const int v=mixAcc[i];
+		mixBuf[i]=(short)(v>32767 ? 32767 : (v<-32768 ? -32768 : v));
+	}
+
+	int done=0;
+	while(done<want)
+	{
+		const int w=(int)DSP_WRITE(dsp,(const char *)mixBuf+done,want-done);
+		if(0>=w)
+		{
+			break;     // EAGAIN (full) or an error: the rest is dropped
+		}
+		done+=w;
+	}
 }
 
 
