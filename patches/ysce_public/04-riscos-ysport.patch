diff --git a/src/ysport/src/riscos/ysopenurl.cpp b/src/ysport/src/riscos/ysopenurl.cpp
new file mode 100644
index 0000000..b11a77a
--- /dev/null
+++ b/src/ysport/src/riscos/ysopenurl.cpp
@@ -0,0 +1,21 @@
+/* YsOpenURL for RISC OS: hand the URL to the URI handler (URI_Dispatch),
+   which passes it to whichever browser is registered.
+   Part of the RISC OS port of YSFlight; same BSD-3 licence as the rest of ysport. */
+
+#include <kernel.h>
+#include "../ysopenurl.h"
+
+#define URI_Dispatch 0x4E381
+
+YSRESULT YsOpenURL(const char urlStr[])
+{
+	_kernel_swi_regs r;
+	r.r[0]=0;               /* flags: dispatch now */
+	r.r[1]=(int)urlStr;
+	r.r[2]=0;               /* sender task handle: none */
+	if(NULL==_kernel_swi(URI_Dispatch,&r,&r) && 0==(r.r[0]&1))
+	{
+		return YSOK;        /* bit 0 of R0 set on exit = request rejected */
+	}
+	return YSERR;
+}
diff --git a/src/ysport/src/riscos/ysriscoserror.cpp b/src/ysport/src/riscos/ysriscoserror.cpp
new file mode 100644
index 0000000..1728ae3
--- /dev/null
+++ b/src/ysport/src/riscos/ysriscoserror.cpp
@@ -0,0 +1,44 @@
+/* RISC OS: report crashes with the RISC OS error and a backtrace.
+
+   UnixLib turns a processor exception (a data abort, say) into SIGEMT and a
+   RISC OS error into SIGOSERROR. Its own report names the signal but leaves
+   out the error itself, which says what happened and where ("abort on data
+   transfer at &...", which shows whether the fault was in the program or in
+   a module). This handler writes that error and UnixLib's backtrace of every
+   thread to stderr (which !Run sends to YSFlightLog), then stops with _exit.
+
+   Same approach as riscos-openttd's patch 15. Part of the RISC OS port of
+   YSFlight; same BSD-3 licence as the rest of ysport. */
+
+/* Built only for RISC OS; the Linux-ARM alignment test builds this
+   directory too (with RISCOS=1) and gets nothing from this file. */
+#ifdef __riscos__
+
+#include <signal.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <kernel.h>
+#include <unixlib/local.h>
+
+#include "../ysport.h"
+
+static void YsRiscOsErrorReport(int signum)
+{
+	const _kernel_oserror *e=_kernel_last_oserror();
+	if(NULL!=e)
+	{
+		fprintf(stderr,"\nRISC OS error &%X: %s\n",(unsigned int)e->errnum,e->errmess);
+	}
+	__write_backtrace(signum);
+	fflush(stderr);
+	/* _exit, not exit: memory may be damaged, so run no destructors. */
+	_exit(2);
+}
+
+void YsRiscOsInstallErrorReport(void)
+{
+	signal(SIGEMT,YsRiscOsErrorReport);
+	signal(SIGOSERROR,YsRiscOsErrorReport);
+}
+
+#endif /* __riscos__ */
diff --git a/src/ysport/src/riscos/ysriscosspecialpath.cpp b/src/ysport/src/riscos/ysriscosspecialpath.cpp
new file mode 100644
index 0000000..3b6dc6a
--- /dev/null
+++ b/src/ysport/src/riscos/ysriscosspecialpath.cpp
@@ -0,0 +1,104 @@
+/* YsSpecialPath for RISC OS.
+   Paths are returned in UnixLib's Unix form ("<Var$Dir>/name"), which UnixLib
+   turns back into RISC OS paths when files are opened.
+   - Program file/base dir: <YSFlight$Dir> (set by !Run), else the current directory.
+   - User/doc/app-data dir: <Choices$Write>/YSFlight, created on first use.
+   Part of the RISC OS port of YSFlight; same BSD-3 licence as the rest of ysport. */
+
+#include <stdlib.h>
+#include <sys/stat.h>
+
+#include <ysclass.h>
+#include "../ysspecialpath.h"
+
+static const char *YsRiscOsAppDir(void)
+{
+	if(NULL!=getenv("YSFlight$Dir"))
+	{
+		return "<YSFlight$Dir>";
+	}
+	return ".";
+}
+
+static YSRESULT YsRiscOsChoicesDir(YsString &path)
+{
+	if(NULL!=getenv("Choices$Write"))
+	{
+		mkdir("<Choices$Write>/YSFlight",493); // 0755
+		path.Set("<Choices$Write>/YSFlight");
+		return YSOK;
+	}
+	return YSERR;
+}
+
+YSRESULT YsSpecialPath::GetProgramFileName(YsString &path)
+{
+	path.MakeFullPathName(YsRiscOsAppDir(),"!RunImage");
+	return YSOK;
+}
+
+YSRESULT YsSpecialPath::GetProgramFileName(YsWString &wpath)
+{
+	YsString path;
+	GetProgramFileName(path);
+	wpath.SetUTF8String(path);
+	return YSOK;
+}
+
+YSRESULT YsSpecialPath::GetProgramBaseDir(YsString &path)
+{
+	path.Set(YsRiscOsAppDir());
+	return YSOK;
+}
+
+YSRESULT YsSpecialPath::GetProgramBaseDir(YsWString &wpath)
+{
+	wpath.SetUTF8String(YsRiscOsAppDir());
+	return YSOK;
+}
+
+YSRESULT YsSpecialPath::GetUserDir(YsString &path)
+{
+	return YsRiscOsChoicesDir(path);
+}
+
+YSRESULT YsSpecialPath::GetUserDir(YsWString &wpath)
+{
+	YsString path;
+	if(YSOK==YsRiscOsChoicesDir(path))
+	{
+		wpath.SetUTF8String(path);
+		return YSOK;
+	}
+	return YSERR;
+}
+
+YSRESULT YsSpecialPath::GetUserDocDir(YsString &path)
+{
+	return YsRiscOsChoicesDir(path);
+}
+
+YSRESULT YsSpecialPath::GetUserDocDir(YsWString &wpath)
+{
+	return GetUserDir(wpath);
+}
+
+YSRESULT YsSpecialPath::GetUserAppDataDir(YsString &path)
+{
+	return YsRiscOsChoicesDir(path);
+}
+
+YSRESULT YsSpecialPath::GetUserAppDataDir(YsWString &wpath)
+{
+	return GetUserDir(wpath);
+}
+
+YSRESULT YsSpecialPath::GetAllUsersDir(YsString &)
+{
+	return YSERR;
+}
+
+YSRESULT YsSpecialPath::GetAllUsersDir(YsWString &)
+{
+	return YSERR;
+}
