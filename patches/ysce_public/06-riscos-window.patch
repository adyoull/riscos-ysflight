+void FsX11SetClipBoardString(long long int length,const char str[])
+{
+	if(NULL!=clipBoard)
+	{
+		delete [] clipBoard;
+	}
+	clipBoard=new char [length+1];
+	memcpy(clipBoard,str,length);
+	clipBoard[length]=0;
+	clipBoardLength=length;
+}
