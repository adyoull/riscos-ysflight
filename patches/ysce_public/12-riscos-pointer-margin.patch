+/* The mouse's bounding box: the whole screen, with the bottom raised by
+   'bottom' OS units (OS_Word 21,1). */
+static void WriteMouseBox(int bottom)
+{
+	int right=(screenW<<xEig)-1,top=(screenH<<yEig)-1;
+	unsigned char b[9];
+	b[0]=1;
+	b[1]=0; b[2]=0;
+	b[3]=bottom&255; b[4]=(bottom>>8)&255;
+	b[5]=right&255;  b[6]=(right>>8)&255;
+	b[7]=top&255;    b[8]=(top>>8)&255;
+	_kernel_osword(21,(int *)b);
+}
+
+static void RestoreMouseBox(void)
+{
+	if(0!=boxRaised)
+	{
+		WriteMouseBox(0);
+		boxRaised=0;
+	}
+}
+
+/* Over the full screen window: keep the pointer off the screen's bottom
+   row, or the icon bar comes forward over the game. */
+static void KeepPointerOffBottom(int keep)
+{
+	int raise=0;
+	if(0!=keep)
+	{
+		if(boxMargin<0)
+		{
+			const char *v=getenv("YSFlight$PointerMargin");
+			boxMargin=2;
+			if(NULL!=v && '0'<=*v && *v<='9')
+			{
+				boxMargin=atoi(v);
+				if(64<boxMargin) boxMargin=64;
+			}
+		}
+		raise=boxMargin<<yEig;
+	}
+	if(raise!=boxRaised)
+	{
+		WriteMouseBox(raise);
+		boxRaised=raise;
+	}
+}
+
