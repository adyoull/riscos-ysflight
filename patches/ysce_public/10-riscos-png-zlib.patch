+int YsRawPngDecoder::OutputBlock(const unsigned char dat[],size_t n)
+{
+#ifdef YS_PNG_ZLIB
+	// Whole rows for non-interlaced 8-bit images: the same filtering and
+	// conversion as Output, row by row.
+	int bpp=0;
+	if(0==hdr.interlaceMethod && 8==hdr.bitDepth)
+	{
+		switch(hdr.colorType)
+		{
+		case 0: bpp=1; break;
+		case 2: bpp=3; break;
+		case 3: bpp=1; break;
+		case 4: bpp=2; break;
+		case 6: bpp=4; break;
+		}
+	}
+	if(0==bpp || nullptr==curLine8 || nullptr==rgba)
+	{
+		return YsGenericPngDecoder::OutputBlock(dat,n);
+	}
+
+	const int rowBytes=wid*bpp;
+	size_t i=0;
+	while(i<n && y<hei)
+	{
+		if(x==-1)
+		{
+			filter=dat[i++];
+			inLineCount=0;
+			x=0;
+			continue;
+		}
+		size_t take=(size_t)(rowBytes-inLineCount);
+		if(n-i<take)
+		{
+			take=n-i;
+		}
+		memcpy(curLine8+inLineCount,dat+i,take);
+		inLineCount+=(int)take;
+		i+=take;
+		if(inLineCount<rowBytes)
+		{
+			break;
+		}
+
+		// Unfilter (PNG specification 9.2). Above the first row counts as 0.
+		unsigned char *cur=curLine8;
+		const unsigned char *prv=prvLine8;
+		if(0==y)
+		{
+			memset(prvLine8,0,rowBytes);
+		}
+		switch(filter)
+		{
+		case 1:
+			for(int k=bpp; k<rowBytes; ++k)
+			{
+				cur[k]+=cur[k-bpp];
+			}
+			break;
+		case 2:
+			for(int k=0; k<rowBytes; ++k)
+			{
+				cur[k]+=prv[k];
+			}
+			break;
+		case 3:
+			for(int k=0; k<bpp; ++k)
+			{
+				cur[k]+=(unsigned char)(prv[k]/2);
+			}
+			for(int k=bpp; k<rowBytes; ++k)
+			{
+				cur[k]+=(unsigned char)(((unsigned int)cur[k-bpp]+prv[k])/2);
+			}
+			break;
+		case 4:
+			for(int k=0; k<bpp; ++k)
+			{
+				cur[k]+=prv[k];   // Paeth(0,b,0) is b
+			}
+			for(int k=bpp; k<rowBytes; ++k)
+			{
+				cur[k]+=Paeth(cur[k-bpp],prv[k],prv[k-bpp]);
+			}
+			break;
+		}
+
+		// Convert to RGBA as Output does
+		unsigned char *o=rgba+(size_t)y*wid*4;
+		switch(hdr.colorType)
+		{
+		case 0:
+			for(int k=0; k<wid; ++k,o+=4)
+			{
+				const unsigned int v=cur[k];
+				o[0]=o[1]=o[2]=(unsigned char)v;
+				o[3]=((v==trns.col[0] || v==trns.col[1] || v==trns.col[2]) ? 0 : 255);
+			}
+			break;
+		case 2:
+			for(int k=0; k<wid; ++k,o+=4)
+			{
+				const unsigned char *s=cur+k*3;
+				o[0]=s[0];
+				o[1]=s[1];
+				o[2]=s[2];
+				o[3]=((s[0]==trns.col[0] && s[1]==trns.col[1] && s[2]==trns.col[2]) ? 0 : 255);
+			}
+			break;
+		case 3:
+			for(int k=0; k<wid; ++k,o+=4)
+			{
+				const unsigned int colIdx=cur[k];
+				if(colIdx<plt.nEntry)
+				{
+					o[0]=plt.entry[colIdx*3  ];
+					o[1]=plt.entry[colIdx*3+1];
+					o[2]=plt.entry[colIdx*3+2];
+					o[3]=((colIdx==trns.col[0] || colIdx==trns.col[1] || colIdx==trns.col[2]) ? 0 : 255);
+				}
+			}
+			break;
+		case 4:
+			for(int k=0; k<wid; ++k,o+=4)
+			{
+				o[0]=o[1]=o[2]=cur[k*2];
+				o[3]=cur[k*2+1];
+			}
+			break;
+		case 6:
+			memcpy(o,cur,(size_t)wid*4);
+			break;
+		}
+
+		index=(unsigned int)((y+1)*wid*4);
+		y++;
+		x=-1;
+		ShiftTwoLineBuf();
+	}
+	return YSOK;
+#else
+	return YsGenericPngDecoder::OutputBlock(dat,n);
+#endif
+}
+
 void YsRawPngDecoder::Flip(void)  // For drawing in OpenGL
 {
+#ifdef YS_PNG_ZLIB
+	// Whole rows at a time.
+	const size_t rowLng=(size_t)wid*4;
+	unsigned char *tmp=new unsigned char [rowLng];
+	for(int y=0; y<hei/2; y++)
+	{
+		unsigned char *a=rgba+y*rowLng,*b=rgba+(hei-1-y)*rowLng;
+		memcpy(tmp,a,rowLng);
+		memcpy(a,b,rowLng);
+		memcpy(b,tmp,rowLng);
+	}
+	delete [] tmp;
+	return;
+#endif
 	int x,y,bytePerLine;
 	unsigned int swp;
 	bytePerLine=wid*4;
