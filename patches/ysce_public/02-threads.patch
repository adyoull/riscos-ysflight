 void YsRunTaskParallel(YSSIZE_T nTask,YsTask *const task[])
 {
+#ifdef __riscos__
+	if(YsRiscOsThreadsOff())
+	{
+		for(YSSIZE_T idx=0; idx<nTask; ++idx)
+		{
+			task[idx]->StartLocal();
+		}
+		return;
+	}
+#endif
 	if(1==nTask)
 	{
 		task[0]->StartLocal();
