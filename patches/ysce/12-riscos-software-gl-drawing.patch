+#if defined(__riscos__) || defined(YS_SOFTWARE_GL)
+// Per-vertex GL_EXP2 fog worked out here, for the large background
+// polygons (sky cylinder, ground mesh): with GL fog off and the depth test
+// off they take riscos-mesa's fast smooth-shaded triangle path instead of
+// the general one. Mesa itself computes fog per vertex for these (fog hint
+// GL_DONT_CARE), so the picture is the same.
+class FsSoftwareVertexFog
+{
+public:
+	GLfloat mv[16],fogCol[4],density;
+	GLboolean fogOn;
+	FsSoftwareVertexFog()
+	{
+		glGetFloatv(GL_MODELVIEW_MATRIX,mv);
+		glGetFloatv(GL_FOG_COLOR,fogCol);
+		glGetFloatv(GL_FOG_DENSITY,&density);
+		fogOn=glIsEnabled(GL_FOG);
+	}
+	void Colour(float rgb[3],float x,float y,float z,float r,float g,float b) const
+	{
+		float f=1.0F;
+		if(GL_TRUE==fogOn)
+		{
+			const float ez=mv[2]*x+mv[6]*y+mv[10]*z+mv[14];
+			const float t=density*(ez<0.0F ? -ez : ez);
+			f=expf(-t*t);
+		}
+		rgb[0]=f*r+(1.0F-f)*fogCol[0];
+		rgb[1]=f*g+(1.0F-f)*fogCol[1];
+		rgb[2]=f*b+(1.0F-f)*fogCol[2];
+	}
+};
+#endif
