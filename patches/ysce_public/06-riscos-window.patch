+
+void FsSetMousePosition(int mx,int my)
+{
+	unsigned char b[5];
+	int ww,wh,pw,ph;
+	WindowPixels(ww,wh);
+	ProgramSize(pw,ph);
+	int x=visible[0]+((mx*ww/pw)<<xEig);
+	int y=visible[3]-1-((my*wh/ph)<<yEig);
+	b[0]=3;                                 /* OS_Word 21,3: set pointer position */
+	b[1]=x&255;
+	b[2]=(x>>8)&255;
+	b[3]=y&255;
+	b[4]=(y>>8)&255;
+	_kernel_osword(21,(int *)b);
+}
+
+int FsGetMouseEvent(int &lb,int &mb,int &rb,int &mx,int &my)
+{
+	if(0<nMosBufUsed)
+	{
+		int eventType=mosBuffer[0].eventType;
+		mx=mosBuffer[0].mx;
+		my=mosBuffer[0].my;
+		lb=mosBuffer[0].lb;
+		mb=mosBuffer[0].mb;
+		rb=mosBuffer[0].rb;
+		nMosBufUsed--;
+		memmove(mosBuffer,mosBuffer+1,nMosBufUsed*sizeof(mosBuffer[0]));
+		return eventType;
+	}
+	FsGetMouseState(lb,mb,rb,mx,my);
+	return FSMOUSEEVENT_NONE;
+}
