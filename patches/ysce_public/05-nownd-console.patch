+	#elif defined(__riscos__)
+		// OS_Byte 129 with time limit 0: R2=0 and R1=key if one is waiting.
+		// Cursor keys arrive as 0x8C-0x8F (left,right,down,up) by default.
+		_kernel_swi_regs r;
+		r.r[0]=129;
+		r.r[1]=0;
+		r.r[2]=0;
+		if(NULL==_kernel_swi(6 /* OS_Byte */,&r,&r) && 0==r.r[2])
+		{
+			int ky=r.r[1]&0xff;
+			switch(ky)
+			{
+			case 0x8c: FsPushKey(FSKEY_LEFT);  break;
+			case 0x8d: FsPushKey(FSKEY_RIGHT); break;
+			case 0x8e: FsPushKey(FSKEY_DOWN);  break;
+			case 0x8f: FsPushKey(FSKEY_UP);    break;
+			default:
+				FsPushChar(ky);
+				FsPushKey(mapVKtoFSKEY[ky]);
+				break;
+			}
+		}
 	#else
 		int ky;
 		ky=getchar();
