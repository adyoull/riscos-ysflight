 #include "ysthreadpool.h"
+#include <cstdio>
+#ifdef __riscos__
+#include <cstdlib>
+#include <cstring>
+
+bool YsRiscOsThreadsOff(void)
+{
+	static int off=-1;
+	if(off<0)
+	{
+		const char *v=getenv("YSFlight$Threads");
+		off=(NULL!=v && 0==strcmp(v,"0")) ? 1 : 0;
+	}
+	return 1==off;
+}
+#endif
 
 
 
