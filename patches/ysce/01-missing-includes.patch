Add missing #include <string>.

core/fshud2.cpp and gui/fsguinetdialog.h use std::string without including
<string>. Newer GCC (13 on the Linux host) and GCCSDK GCC 10 both stop
there. Not RISC OS specific; upstream could take it as it is.

For YSCE 231e711. See docs/PORTING-NOTES.md in riscos-ysflight.

diff --git a/src/core/fshud2.cpp b/src/core/fshud2.cpp
index ce48bcb..8939139 100644
--- a/src/core/fshud2.cpp
+++ b/src/core/fshud2.cpp
@@ -1,3 +1,4 @@
+#include <string>
 #include <ysclass.h>
 #include <ysunitconv.h>
 #include "fs.h"
diff --git a/src/gui/fsguinetdialog.h b/src/gui/fsguinetdialog.h
index 5e3e3c3..add1eac 100644
--- a/src/gui/fsguinetdialog.h
+++ b/src/gui/fsguinetdialog.h
@@ -1,3 +1,4 @@
+#include <string>
 #ifndef FSGUINETDIALOG_IS_INCLUDED
 #define FSGUINETDIALOG_IS_INCLUDED
 /* { */
